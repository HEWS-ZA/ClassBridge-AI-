  "lessonPlans": [
    {
      "id": "plan-1",
      "grade": "Grade 12",
      "subject": "Mathematics",
      "topic": "Calculus: Limits and Differential Coefficients",
      "standardNotes": "Definition of a limit. Finding differential coefficients from first principles: f'(x) = lim[h->0](f(x+h) - f(x))/h. Power rule for differentiation: d/dx(x^n) = n*x^(n-1). Standard CAPS curriculum pacing guideline for Term 2.",
      "curriculumReference": "CAPS Mathematics Section 3.1.2"
    },
    {
      "id": "plan-2",
      "grade": "Grade 11",
      "subject": "Life Sciences",
      "topic": "Photosynthesis: Light and Dark Phases",
      "standardNotes": "Structure of chloroplasts. Light-dependent phase (occurs in thylakoids, produces ATP and NADPH, releases oxygen). Light-independent/Dark phase (occurs in stroma, fixes CO2 into glucose using Calvin Cycle). Environmental factors affecting photosynthesis (light intensity, CO2 concentration, temperature).",
      "curriculumReference": "CAPS Life Sciences Section 2.1.1"
    },
    {
      "id": "plan-3",
      "grade": "Grade 12",
      "subject": "Physical Sciences",
      "topic": "Newton's Second Law of Motion",
      "standardNotes": "Statement of Newton's Second Law: When a net force acts on an object, the object accelerates in the direction of the net force with an acceleration directly proportional to the force and inversely proportional to the mass. Equation: F_net = m*a. Free body diagrams and frictional forces (static and kinetic).",
      "curriculumReference": "CAPS Physical Sciences Section 1.4.2"
    },
    {
      "id": "plan-4",
      "grade": "Grade 12",
      "subject": "English First Additional Language",
      "topic": "Literary Study: Hamlet Act III Scene 1 (Soliloquy)",
      "standardNotes": "Analysis of Hamlet's famous \"To be or not to be\" soliloquy. Themes of life, death, action vs. inaction. Key literary devices: metaphor, soliloquy, rhetorical questioning. Understanding early modern English vocabulary in context.",
      "curriculumReference": "CAPS English FAL Section 2.4.1"
    }
  ],
